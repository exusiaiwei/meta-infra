# chezmoi 配置模板
# 首次 chezmoi init 时会执行，询问用户信息并写入 ~/.config/chezmoi/chezmoi.toml

[data]
    email = "{{ promptStringOnce . "email" "Git email" }}"
    name = "{{ promptStringOnce . "name" "Git username" }}"

# PowerShell 脚本解释器配置
# 新装 Windows 默认执行策略为 Restricted，必须用 Bypass 才能执行 .ps1 脚本
[interpreters.ps1]
    command = "powershell.exe"
    args = ["-NoProfile", "-ExecutionPolicy", "Bypass"]
