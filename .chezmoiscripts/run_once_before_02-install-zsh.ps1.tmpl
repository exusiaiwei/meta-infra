{{ if eq .chezmoi.os "windows" -}}
# =============================================================================
# 02 - Install Zsh + Plugins + Bridge MSYS2 HOME
# =============================================================================
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$OutputEncoding = [System.Text.Encoding]::UTF8
$ErrorActionPreference = "Continue"

$BASH_EXE = "C:\msys64\usr\bin\bash.exe"
$MSYS2_HOME = "C:\msys64\home\$env:USERNAME"
$WIN_HOME = $env:USERPROFILE

if (Test-Path $BASH_EXE) {
    $env:MSYSTEM = "MSYS"
    $env:CHERE_INVOKING = "1"

    # ---- Bridge MSYS2 home to Windows home ----
    # MSYS2 zsh reads ~/.zshenv from /home/<user>/, but chezmoi deploys to C:\Users\<user>/
    # Create stub files in MSYS2 home that source the real ones
    Write-Host ">> Bridging MSYS2 home to Windows home..." -ForegroundColor Cyan

    if (-not (Test-Path $MSYS2_HOME)) {
        New-Item -ItemType Directory -Path $MSYS2_HOME -Force | Out-Null
    }

    # .zshenv stub
    $winUser = $env:USERNAME
    $stubEnv = "# Auto-generated by meta-infra: source real .zshenv from Windows home`nsource /c/Users/$winUser/.zshenv"
    Set-Content -Path "$MSYS2_HOME\.zshenv" -Value $stubEnv -Force -NoNewline:$false
    Write-Host "   OK .zshenv stub created" -ForegroundColor Green

    # .zshrc stub
    $stubRc = "# Auto-generated by meta-infra: source real .zshrc from Windows home`nsource /c/Users/$winUser/.zshrc"
    Set-Content -Path "$MSYS2_HOME\.zshrc" -Value $stubRc -Force -NoNewline:$false
    Write-Host "   OK .zshrc stub created" -ForegroundColor Green

    # starship.toml stub (symlink via cmd, since PowerShell symlinks need admin)
    $starshipDir = "$MSYS2_HOME\.config"
    if (-not (Test-Path $starshipDir)) { New-Item -ItemType Directory -Path $starshipDir -Force | Out-Null }
    if (-not (Test-Path "$starshipDir\starship.toml")) {
        Copy-Item "$WIN_HOME\.config\starship.toml" "$starshipDir\starship.toml" -ErrorAction SilentlyContinue
        Write-Host "   OK starship.toml copied" -ForegroundColor Green
    }

    # Also try nsswitch.conf (helps for future sessions)
    & $BASH_EXE -lc "sed -i 's/^db_home:.*/db_home: windows/' /etc/nsswitch.conf" 2>$null

    # ---- Pacman mirror (USTC) ----
    Write-Host ">> Configuring pacman mirror (USTC)..." -ForegroundColor Cyan
    & $BASH_EXE -lc "grep -q 'mirrors.ustc.edu.cn' /etc/pacman.d/mirrorlist.msys 2>/dev/null || sed -i '1i Server = https://mirrors.ustc.edu.cn/msys2/msys/\$arch' /etc/pacman.d/mirrorlist.msys" 2>$null
    Write-Host "   OK pacman mirror" -ForegroundColor Green

    # ---- Install zsh + plugins ----
    Write-Host ">> Installing zsh + plugins..." -ForegroundColor Cyan
    & $BASH_EXE -lc "pacman -Sy --noconfirm 2>&1 && pacman -S --noconfirm --needed zsh zsh-syntax-highlighting zsh-autosuggestions 2>&1"
    if ($LASTEXITCODE -eq 0) {
        Write-Host "   OK zsh + plugins ready" -ForegroundColor Green
    } else {
        Write-Host "   WARN pacman may have issues (exit: $LASTEXITCODE)" -ForegroundColor Yellow
    }
} else {
    Write-Host "   WARN MSYS2 not found, skipping" -ForegroundColor Yellow
}

{{ end -}}
