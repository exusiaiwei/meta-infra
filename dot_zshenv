# =============================================================================
# .zshenv — 所有 zsh 实例都会加载（包括非交互式，如 AI agent 调用）
# =============================================================================
# 这个文件只设置 PATH 和环境变量，不做任何交互式配置

# ---------- HOME 目录统一 ----------
# MSYS2 默认 HOME=/home/<user>，但我们的文件都在 Windows 用户目录下
# 将 HOME 重定向到 /c/Users/<user>，使 ~ 路径一致
if [[ -d "/c/Users" ]] && [[ "$HOME" == /home/* ]]; then
  _user="${USERNAME:-$(basename "$HOME")}"
  if [[ -d "/c/Users/$_user" ]]; then
    export HOME="/c/Users/$_user"
  fi
  unset _user
fi

# MSYS2 工具链
export PATH="/clangarm64/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# 动态添加路径（存在才加）
_add_path() { [[ -d "$1" ]] && export PATH="$1:$PATH"; }

# Windows 系统路径（winget/系统工具需要）
_add_path "/c/Windows/System32"
_add_path "/c/Windows"

# WinGet Links（winget 安装的 CLI 工具快捷方式）
_add_path "$HOME/AppData/Local/Microsoft/WinGet/Links"

# Mise（多种安装方式）
_add_path "$HOME/.local/share/mise/bin"
_add_path "$HOME/.local/bin"
_add_path "$HOME/AppData/Local/Programs/mise/bin"
_add_path "$HOME/AppData/Local/mise/bin"
# winget 安装的 mise 和 chezmoi（glob 可能在长路径下失败，用 find 兜底）
() {
  setopt localoptions nullglob
  local pkg_base="$HOME/AppData/Local/Microsoft/WinGet/Packages"
  # Try glob first
  for d in "$pkg_base"/jdx.mise_*/mise/bin; do _add_path "$d"; done
  for d in "$pkg_base"/twpayne.chezmoi_*; do _add_path "$d"; done
  # Fallback: find
  if ! command -v mise &>/dev/null && [[ -d "$pkg_base" ]]; then
    local mise_dir=$(find "$pkg_base" -maxdepth 3 -name 'mise.exe' -print -quit 2>/dev/null)
    [[ -n "$mise_dir" ]] && _add_path "$(dirname "$mise_dir")"
  fi
}

# Starship
_add_path "/c/Program Files/starship/bin"

# Pixi（如果存在）
_add_path "$HOME/.pixi/bin"

# ---------- 终极兜底：问 PowerShell ----------
# 如果以上所有路径都没找到 mise，让 PowerShell 告诉我们它在哪
if ! command -v mise &>/dev/null; then
  _win_path=$(powershell.exe -NoProfile -Command '(Get-Command mise -ErrorAction SilentlyContinue).Source' 2>/dev/null | tr -d '\r\n')
  if [[ -n "$_win_path" ]]; then
    # C:\foo\bar → /c/foo/bar
    _unix_dir=$(echo "$_win_path" | sed 's|\\|/|g; s|^\([A-Za-z]\):|/\L\1|' | xargs dirname)
    _add_path "$_unix_dir"
  fi
  unset _win_path _unix_dir
fi

unset -f _add_path

# 编辑器
export EDITOR="code"
export VISUAL="code"

# 语言
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
