# =============================================================================
# .zshenv — 所有 zsh 实例都会加载（包括非交互式，如 AI agent 调用）
# =============================================================================
# 这个文件只设置 PATH 和环境变量，不做任何交互式配置

# ---------- HOME 目录统一 ----------
if [[ -d "/c/Users" ]] && [[ "$HOME" == /home/* ]]; then
  _user="${USERNAME:-$(basename "$HOME")}"
  if [[ -d "/c/Users/$_user" ]]; then
    export HOME="/c/Users/$_user"
  fi
  unset _user
fi

# MSYS2 工具链
export PATH="/clangarm64/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# 动态添加路径（存在才加）
_add_path() { [[ -d "$1" ]] && export PATH="$1:$PATH"; }

# Windows 系统路径
_add_path "/c/Windows/System32"
_add_path "/c/Windows"

# WinGet Links
_add_path "$HOME/AppData/Local/Microsoft/WinGet/Links"

# Mise
export MISE_GLOBAL_CONFIG_FILE="$HOME/_Meta/meta-infra/mise.toml"
_add_path "$HOME/.local/share/mise/bin"
_add_path "$HOME/.local/bin"
_add_path "$HOME/AppData/Local/Programs/mise/bin"
_add_path "$HOME/AppData/Local/mise/bin"
() {
  setopt localoptions nullglob
  local pkg_base="$HOME/AppData/Local/Microsoft/WinGet/Packages"
  for d in "$pkg_base"/jdx.mise_*/mise/bin; do _add_path "$d"; done
  for d in "$pkg_base"/twpayne.chezmoi_*; do _add_path "$d"; done
}

# Starship
_add_path "/c/Program Files/starship/bin"

# Pixi
_add_path "$HOME/.pixi/bin"

unset -f _add_path

# 编辑器
export EDITOR="code"
export VISUAL="code"

# 语言
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
